{
  "name": "karaoke-party",
  "version": "1.0.0",
  "description": "A real-time karaoke party song list manager",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev:server": "node server.js",
    "dev:client": "vite",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "build": "vite build",
    "preview": "vite preview",
    "postinstall": "mkdir -p /app/.data && npm run build"
  },
  "dependencies": {
    "express": "^4.18.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "lucide-react": "^0.294.0",
    "concurrently": "^8.2.2",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.16",
    "postcss": "^8.4.31",
    "tailwindcss": "^3.3.5",
    "@tailwindcss/forms": "^0.5.7",
    "vite": "^5.0.10"
  },
  "engines": {
    "node": "16.x"
  },
  "license": "MIT"
}
